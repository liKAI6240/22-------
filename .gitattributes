# ============================================================================
#  22 届视觉仿真环境 —— git 属性
# ----------------------------------------------------------------------------
#  为什么需要这个文件：
#  本工程里有两类文件对「行尾 / 编码」极度敏感，一旦被 git 自动转换就会坏：
#    1) 视觉仿真环境.dev  —— 必须是 GBK 编码 + CRLF 换行，否则 Dev-C++ 打不开
#    2) *.bat             —— cmd 对只有 LF 的批处理会解析错乱（实测会报「系统
#                            找不到指定的路径」）
#  所以这里把它们的行为钉死，不依赖本机的 core.autocrlf 设置。
# ============================================================================

# ---- 图片与库文件：纯二进制，禁止任何转换 ----
*.bmp   binary
*.png   binary
*.jpg   binary
*.lib   binary
*.exe   binary
*.pdb   binary

# ---- Dev-C++ 工程文件：GBK + CRLF，按二进制原样保存 ----
*.dev   binary

# ---- 批处理脚本：必须 CRLF ----
*.bat   text eol=crlf
