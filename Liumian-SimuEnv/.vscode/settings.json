{
    "files.associations": {
        "*.h": "c"
    },
    "[c]": {
        "files.encoding": "utf8bom",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "files.encoding": "utf8bom",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "search.exclude": {
        "**/VS/x64": true,
        "**/VS/visual_simu": true,
        "**/pic": true,
        "**/.git": true
    },
    "files.watcherExclude": {
        "**/VS/x64/**": true,
        "**/pic/**": true
    },
    "git.autoRepositoryDetection": "subFolders"
}
